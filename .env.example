# Required: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
# Optional: public https URL of this app. If set, TinyFish Monitor POSTs every scheduled run to /api/webhook/monitor
PUBLIC_URL=
WEBHOOK_SECRET=change-me
# Cron for each TinyFish Page Monitor (UTC)
SCHEDULE_CRON=0 * * * *
# Local fallback poller (minutes) that triggers Monitor "run now" for every page; 0 disables
POLL_MINUTES=60
# Protects delete / run-all / reschedule endpoints (leave empty locally)
ADMIN_TOKEN=
